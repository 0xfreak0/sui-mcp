# All variables are optional. Defaults connect to Sui mainnet public endpoints.

# Default network when a tool call doesn't specify one: mainnet (default),
# testnet, devnet. This is only the DEFAULT — every tool also accepts a per-call
# `network` argument, so a single session can query multiple networks at once.
SUI_NETWORK=mainnet

# Override the DEFAULT network's RPC endpoints. These apply only to SUI_NETWORK;
# calls that target a different network use that network's canonical public endpoints.
SUI_FULLNODE_URL=https://fullnode.mainnet.sui.io
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# Move Registry (MVR) base URL — defaults follow SUI_NETWORK
# (mainnet → mainnet.mvr.mystenlabs.com/v1, testnet → testnet.mvr.mystenlabs.com/v1).
# Devnet has no MVR endpoint; MVR tools will return an error.
# SUI_MVR_URL=https://mainnet.mvr.mystenlabs.com/v1

# Path to Revela move-decompiler binary (for decompile_module tool)
# SUI_DECOMPILER_PATH=/path/to/move-decompiler

# Local address-label overrides for incident investigation. JSON file (see
# labeled-addresses.example.json) mapping addresses to attribution labels
# (exchanges, bridges, mixers, malicious wallets, ...). Overrides the shipped
# static set and is consulted by fund tracing to stop at known sinks.
# SUI_LABELS_FILE=/path/to/labeled-addresses.json

# Which tool profiles to load at startup. Comma-separated, or 'all'.
# Defaults to 'core' (17 tools) — the full 50 cost ~14k tokens of context on
# every request. The model can enable more mid-session via the enable_tools
# tool, so this only sets the starting surface.
# Profiles: core, forensics, developer, market
# SUI_TOOLS=core,forensics

# Optional local store (SQLite via Node's built-in node:sqlite — no dependency).
# Unset by default: nothing is written to disk unless you set this. Persists
# address labels and fan-out measurements across sessions. Note that an
# investigation store records which addresses you looked at.
# SUI_STORE_PATH=~/.local/share/sui-mcp/store.db

# --- Optional price providers -------------------------------------------
# Current prices come from Aftermath, which is free and needs no key.
# These two are opt-in and are only used when set.

# Pyth Hermes now authenticates price queries (feed discovery is still open).
# Required for historical prices and oracle-vs-market comparison.
# PYTH_API_KEY=

# CoinMarketCap as an extra current-price source. Keys on ticker symbols,
# which are not unique on-chain, so it is consulted only for symbols already
# mapped to a coin type.
# CMC_API_KEY=
