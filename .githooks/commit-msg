#!/usr/bin/env bash
# Scans the commit message, its co-author trailers, and commit identities.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! "$here/leak-scan.sh" "commit message" < "$1"; then
  echo "" >&2
  echo "The commit message was rejected and is preserved at $1" >&2
  exit 1
fi
if ! "$here/identity-check.sh" --current || ! "$here/identity-check.sh" --message < "$1"; then
  echo "The commit identity or co-author trailer was rejected; message preserved at $1" >&2
  exit 1
fi
