#!/usr/bin/env bash
# Scans the COMMIT MESSAGE.
#
# This is the one that matters most: every leak this repo has actually had was
# in a commit message, not in a file. A pre-commit hook alone would have caught
# none of them.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! "$here/leak-scan.sh" "commit message" < "$1"; then
  echo "" >&2
  echo "The commit message was rejected and is preserved at $1" >&2
  exit 1
fi
