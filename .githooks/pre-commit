#!/usr/bin/env bash
# Scans staged content and the author/committer identities.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! git diff --cached | "$here/leak-scan.sh" "staged content"; then
  echo "" >&2
  echo "Nothing was committed. Remove the match, or add an exception to" >&2
  echo ".githooks/patterns if it is a false positive." >&2
  exit 1
fi
if ! "$here/identity-check.sh" --current; then
  echo "Nothing was committed. Set a public author and committer email." >&2
  exit 1
fi
