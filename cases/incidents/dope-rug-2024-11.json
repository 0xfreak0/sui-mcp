        {
          "path": "verified",
          "op": "equals",
          "value": false
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: CoinMetadata name D.O.P.E, 9 decimals, 1B minted to the deployer at publish."
    },
    {
      "id": "token-names-its-pool",
      "question": "Does the token analysis show where DOPE's liquidity sits and who can pull it?",
      "tool": "analyze_token",
      "args": {
        "query": "{coin}",
        "include_holders": false
      },
      "expect": [
