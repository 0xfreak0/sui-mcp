  "checks": [
    {
      "id": "publisher-and-time",
      "question": "Who published DOPE, and when?",
      "tool": "analyze_package",
      "args": {
        "package_id": "{package}"
      },
      "expect": [
        {
          "path": "root_publisher.publisher",
          "op": "iequals",
          "value": "{deployer}"
        },
        {
          "path": "root_publisher.publish_tx",
          "op": "equals",
          "value": "{publish_tx}"
        },
        {
          "path": "root_publisher.published_at",
          "op": "equals",
          "value": "2024-11-13T23:17:03.558Z"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: publish transaction Aws2TK1R, three seconds after the deployer's funding and four seconds before the pool."
    },
    {
      "id": "mint-renounced",
      "question": "Could the deployer mint more DOPE?",
      "tool": "analyze_package",
      "args": {
        "package_id": "{package}"
      },
      "expect": [
        {
          "path": "capabilities.capabilities[*].owner_address",
          "op": "includes",
          "value": "{zero}"
