    {
      "id": "hub-funds-next-pools",
      "question": "What did the hub do with the money after the pull?",
      "tool": "trace_flow_graph",
      "args": {
        "address": "{hub}",
        "direction": "forward",
        "from": "2024-11-14T02:12:00Z",
        "to": "2024-11-16T00:00:00Z",
        "coin_type": "0x2::sui::SUI",
