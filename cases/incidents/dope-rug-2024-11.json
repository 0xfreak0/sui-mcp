          "op": "includes",
          "value": "publisher"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: the TreasuryCap went to 0x0 at publish; the UpgradeCap stayed with the deployer. The pull needed neither."
    },
    {
