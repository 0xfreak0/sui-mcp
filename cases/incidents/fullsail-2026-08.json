        {
          "path": "events[*].tx_digest",
          "op": "includes",
          "value": "{key_swap_tx}"
        },
        {
          "path": "events[*].sender",
          "op": "includes",
          "value": "{attacker}"
        },
        {
          "path": "events[*].data.oracle_id",
          "op": "includes",
          "value": "{compromised_oracle}"
