  "checks": [
    {
      "id": "publisher-and-time",
      "question": "Who published GOBBLE, and when?",
      "tool": "analyze_package",
      "args": {
        "package_id": "{package}"
      },
      "expect": [
        {
          "path": "root_publisher.publisher",
          "op": "iequals",
          "value": "{deployer}"
        },
        {
          "path": "root_publisher.publish_tx",
          "op": "equals",
          "value": "{publish_tx}"
        },
        {
          "path": "root_publisher.published_at",
          "op": "equals",
          "value": "2024-10-10T03:38:13.097Z"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: publish transaction CDkshsFc at checkpoint time 03:38:13 UTC, signed by the same key that later pulled both pools."
    },
    {
      "id": "mint-renounced-upgrade-held",
      "question": "Could the deployer mint more GOBBLE, or change the coin package?",
      "tool": "analyze_package",
      "args": {
        "package_id": "{package}"
      },
      "expect": [
        {
          "path": "capabilities.capabilities[*].owner_address",
          "op": "includes",
          "value": "{zero}"
        },
        {
          "path": "capabilities.capabilities[*].holder_status",
          "op": "includes",
          "value": "publisher"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: TreasuryCap 0x048340a9 was sent to 0x0 in the publish transaction, so mint authority was gone and the rug needed none; the UpgradeCap stayed with the deployer."
    },
    {
      "id": "token-metadata",
      "question": "What is GOBBLE, and is it vouched for?",
      "tool": "analyze_token",
      "args": {
        "query": "{coin}",
        "include_holders": false
      },
      "expect": [
        {
          "path": "name",
          "op": "equals",
          "value": "Gobble"
        },
        {
          "path": "total_supply",
          "op": "equals",
          "value": "1000000000000000000"
        },
        {
          "path": "verified",
          "op": "equals",
          "value": false
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: CoinMetadata name Gobble, 9 decimals; the whole 1B supply was minted to the deployer at publish."
    },
    {
      "id": "token-names-its-pools",
      "question": "Does the token analysis show where GOBBLE's liquidity sits and who can pull it?",
      "tool": "analyze_token",
      "args": {
        "query": "{coin}",
        "include_holders": false
      },
      "expect": [
        {
          "path": "_text",
          "op": "contains",
          "value": "{cetus_pool}"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: GOBBLE's only liquidity was the Cetus pool (and the BlueMove pool), both funded by positions the deployer held in its own wallet. The rug risk sat there, not in a mint authority.",
      "known_defect": "analyze_token names no pool, no liquidity and no LP holder, so the unlocked LP in the deployer's wallet is invisible."
    },
    {
