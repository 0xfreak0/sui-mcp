      "expect": [
        {
          "path": "pools[*].pool_id",
          "op": "includes",
          "value": "{cetus_pool}"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: pool created by EauNeox (pool_script_v2::create_pool_with_liquidity)."
    },
    {
