    {
      "id": "versioned-still-1",
      "question": "What did the shared Versioned object hold when the exploit ran?",
      "tool": "get_object",
      "args": {
        "object_id": "{versioned}",
        "version": 669858312
      },
      "expect": [
        {
          "path": "content.version",
          "op": "equals",
          "value": "1"
        },
        {
          "path": "previous_transaction",
          "op": "equals",
          "value": "{v1_publish_tx}"
        }
      ],
      "tier": "chain-derived",
      "basis": "Chain: Versioned was created at 1 by the v1 publish (2025-11-12) and was not written again until the pause on 2026-06-09, so the v2 and v3 upgrades never raised it. Haedal: the upgrade did not force the old entrypoints out."
    },
    {
      "id": "v1-gate-accepts-1",
      "question": "What stored version does v1's check_version accept?",
      "tool": "disassemble_module",
      "args": {
        "package_id": "{vault_v1}",
        "module_name": "versioned",
        "function_name": "check_version"
      },
      "expect": [
        {
          "path": "disassembly",
          "op": "matches",
          "value": "ImmBorrowField\\[0\\]\\(Versioned\\.version: u64\\)\\n\\t2: ReadRef\\n\\t3: LdConst\\[0\\]\\(u64: 1\\)\\n\\t4: Le\\n\\t5: BrFalse"
        }
      ],
      "tier": "code-derived",
      "basis": "Chain (0xfbc91f75 bytecode): check_version aborts with EVersionDeprecated unless Versioned.version <= 1, so a stored 1 lets every v1 entrypoint run."
    },
    {
      "id": "v3-gate-constant-3",
      "question": "What version constant did the version in force at the exploit carry?",
      "tool": "disassemble_module",
      "args": {
        "package_id": "{vault_v3}",
        "module_name": "versioned",
        "function_name": "check_version"
      },
      "expect": [
        {
          "path": "disassembly",
          "op": "matches",
          "value": "3: LdConst\\[0\\]\\(u64: 3\\)\\n\\t4: Le"
        }
      ],
      "tier": "code-derived",
      "basis": "Chain (0x4893ee66 bytecode): v3 accepts Versioned.version <= 3. Raising the object to 3 would have closed v1 (<= 1); it stayed at 1. Haedal: old entrypoints were left callable instead of forcing the upgrade."
    },
    {
      "id": "v1-aum-ignores-clmm",
      "question": "Which holdings does v1's calculate_aum count before writing last_aum?",
      "tool": "disassemble_module",
      "args": {
        "package_id": "{vault_v1}",
        "module_name": "vault",
        "function_name": "calculate_aum"
      },
      "expect": [
        {
          "path": "disassembly",
          "op": "matches",
          "value": "^(?![\\s\\S]*CLMM)[\\s\\S]*\"DLMM_MARKET\"[\\s\\S]*market_dlmm::last_amounts[\\s\\S]*Vault\\.buffer_assets[\\s\\S]*Call calculate_tvl_base_on_quote\\([^\\n]*\\n\\t\\d+: CopyLoc\\[0\\]\\(Arg0: &mut Vault<Ty0>\\)\\n\\t\\d+: MutBorrowFieldGeneric\\[\\d+\\]\\(Vault\\.last_aum: u128\\)\\n\\t\\d+: WriteRef"
        }
      ],
      "tier": "code-derived",
      "basis": "Chain (0xfbc91f75 bytecode): calculate_aum sums the DLMM_MARKET's last_amounts and the buffer_assets balances, prices them and writes Vault.last_aum; it has no CLMM branch. Haedal: excess LP minted through the old deposit path."
    },
    {
      "id": "v3-aum-counts-clmm",
      "question": "Does the version in force at the exploit count the CLMM market in AUM?",
      "tool": "disassemble_module",
      "args": {
        "package_id": "{vault_v3}",
        "module_name": "vault",
        "function_name": "calculate_aum"
      },
      "expect": [
        {
          "path": "disassembly",
          "op": "contains",
          "value": "\"CLMM_MARKET\""
        },
        {
          "path": "disassembly",
          "op": "contains",
          "value": "market_clmm::last_amounts(&CLMMMarket, &TxContext)"
        }
      ],
      "tier": "code-derived",
      "basis": "Chain (0x4893ee66 bytecode): v3 calculate_aum adds the CLMM_MARKET's last_amounts to the DLMM and buffer totals, so v1 and v3 price the same vault against different AUMs."
    },
    {
      "id": "v1-deposit-no-pair-check",
      "question": "How does v1 deposit size the LP it mints, and does it check the coins against the vault's pair?",
      "tool": "disassemble_module",
      "args": {
        "package_id": "{vault_v1}",
        "module_name": "vault",
        "function_name": "deposit"
      },
      "expect": [
        {
          "path": "disassembly",
          "op": "matches",
          "value": "^(?![\\s\\S]*coin_type_a)[\\s\\S]*Call calculate_tvl_base_on_quote\\([\\s\\S]*ImmBorrowFieldGeneric\\[\\d+\\]\\(Vault\\.last_aum: u128\\)\\n\\t\\d+: ReadRef\\n\\t\\d+: Call get_lp_amount_by_tvl\\(u64, u128, u128\\): u128"
        },
        {
          "path": "disassembly",
          "op": "matches",
          "value": "Call coin::mint<Ty2>[\\s\\S]*Call balance_bag::join<Ty0>[\\s\\S]*Call balance_bag::join<Ty1>"
        }
      ],
      "tier": "code-derived",
      "basis": "Chain (0xfbc91f75 bytecode): deposit prices the two coins by their own types, mints get_lp_amount_by_tvl(supply, tvl, Vault.last_aum) and joins any coin type into buffer_assets; it never reads coin_type_a or coin_type_b. Haedal: excess LP shares minted through an old deposit path."
    },
    {
      "id": "v3-deposit-pair-and-margin",
      "question": "What does the newer deposit check that v1's lacks?",
      "tool": "disassemble_module",
      "args": {
        "package_id": "{vault_v3}",
        "module_name": "vault",
        "function_name": "deposit"
      },
      "expect": [
        {
          "path": "disassembly",
          "op": "contains",
          "value": "EInvalidDepositCoinPair"
        },
        {
          "path": "disassembly",
          "op": "contains",
          "value": "get_aum_safety_margin_bps"
        }
      ],
      "tier": "code-derived",
      "basis": "Chain (0x4893ee66 bytecode): v3 deposit compares the coin types with Vault.coin_type_a/coin_type_b (abort 36) and scales last_aum by an AUM safety margin before sizing LP; v1 has neither."
    },
