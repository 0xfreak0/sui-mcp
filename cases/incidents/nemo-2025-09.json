{
  "slug": "nemo-2025-09",
  "kind": "protocol-exploit",
  "title": "Nemo Protocol exploit, 7 September 2025",
  "network": "mainnet",
  "summary": "An attacker drained Nemo's pools on 7 September 2025. The newest package version at the time, v10, was published by a single key while the UpgradeCap was briefly away from Nemo's multisig. The attacker swapped the stolen SUI to USDC and bridged it to one Ethereum address through Circle CCTP in eight burns.",
  "sources": [
    {
      "url": "https://olivine-hydrofoil-637.notion.site/Nemo-Security-Incident-Cause-Process-and-Fund-Tracing-Report-V1-1-26a6b8723d8a80e29cb8cb48fe1390f2",
      "publisher": "Nemo",
      "kind": "victim-postmortem"
    }
  ],
  "subjects": {
    "attacker": "0x01229b3cc8469779d42d59cfc18141e4b13566b581787bf16eb5d61058c1c724",
    "exploit_tx": "19Zkat1xArMTMvPCB4e4QtM5HstpYiKvgPjbvkLUAw9",
    "cctp_destination": "0x135477aa627a3bcc3223bde10dd8e7c55a1f645c",
    "first_funding_tx": "FjkAurXTGnmq4uiMr1yWETvRCtYWmVpFbrD9MGSyUc3S",
    "first_funder": "0x1f7b27844f2c4a0262b2c481f7ab956d10ace524c5a7b06c3742cfb8701db714",
    "nemo_package": "0x2b71664477755b90f9fb71c9c944d5d0d3832fec969260e3f18efc7d855f57c4",
    "upgrader": "0xf55cc609b13e87470d3da78d39ad6f84458a8059eb06aa66f94103d775e8a663"
  },
  "checks": [
    {
      "id": "exploit-profit",
      "question": "What did the attacker take in the exploit transaction?",
      "tool": "analyze_attack_tx",
      "args": { "digest": "{exploit_tx}" },
      "expect": [
        { "path": "addresses[*].address", "op": "includes", "value": "{attacker}" },
        { "path": "addresses[*].coins[*].amount", "op": "includes", "value": "144834924665034" }
      ],
      "tier": "chain-derived",
      "basis": "The attacker's SUI balance change in the exploit transaction on chain, 144,834.924665034 SUI."
    },
    {
      "id": "cctp-exits",
      "question": "How much left Sui through CCTP on the day, and to whom?",
      "tool": "summarize_address_flows",
      "args": { "address": "{attacker}", "from": "2025-09-07T00:00:00Z", "to": "2025-09-08T00:00:00Z" },
      "expect": [
        { "path": "bridge_exits.by_bridge[*].bridge", "op": "includes", "value": "Circle CCTP" },
        { "path": "bridge_exits.by_bridge[*].destinations[*].address", "op": "includes", "value": "{cctp_destination}" },
        { "path": "bridge_exits.by_bridge[*].destinations[*].address", "op": "count_lte", "value": 1 },
        { "path": "bridge_exits.transaction_count", "op": "equals", "value": 8 },
        { "path": "bridge_exits.transactions[*].beneficiaries[*].address", "op": "count_gte", "value": 8 }
      ],
      "tier": "chain-derived",
      "basis": "Nemo's report V1.1 names the CCTP destination; the attacker's eight DepositForBurn events on chain all pay it."
    },
    {
      "id": "path-to-cctp-destination",
      "question": "Is there a value path from the attacker to the Ethereum address Nemo named?",
      "tool": "find_flow_path",
      "args": { "from": "{attacker}", "to": "eip155:1:{cctp_destination}", "window_start": "2025-09-07T16:00:00Z" },
      "expect": [
        { "path": "found", "op": "equals", "value": true },
        { "path": "paths[*].steps[*].to", "op": "includes", "value": "exit:Circle CCTP:eip155:1:{cctp_destination}" },
        { "path": "paths[*].steps[*].coin", "op": "includes", "value": "USDC" }
      ],
      "tier": "chain-derived",
      "basis": "Nemo's report V1.1 names the destination; the CCTP burns on chain carry it as mint_recipient."
    },
    {
      "id": "forward-trace",
      "question": "Where did the stolen SUI go after the exploit?",
      "tool": "trace_funds",
      "args": { "digest": "{exploit_tx}", "direction": "forward", "hops": 10 },
      "expect": [
        { "path": "hops[0].digest", "op": "equals", "value": "{exploit_tx}" },
        { "path": "hops[1].digest", "op": "equals", "value": "JBoU5bTgXeD6WDcxYZtdfSjkvwwTdhYCAqw5znPi7DaG" },
        { "path": "hops[2].digest", "op": "equals", "value": "9ZzZ6C8mhdoxex6GdRTk2ukNeXT2jEtGPwXRYzenat7N" },
        { "path": "stop_reason", "op": "contains", "value": "Circle CCTP" }
      ],
      "tier": "chain-derived",
      "basis": "Read on chain: the attacker's next SUI debit after the exploit is the swap JBoU5b…, and its next USDC debit is the CCTP burn 9ZzZ6C…."
    },
    {
      "id": "first-funder",
      "question": "Who paid for the attacker's first gas, and does the trace stop there?",
      "tool": "trace_funds",
      "args": { "digest": "{first_funding_tx}", "direction": "backward", "hops": 3 },
      "expect": [
        { "path": "hops[0].sender", "op": "equals", "value": "{first_funder}" },
        { "path": "hop_count", "op": "equals", "value": 1 },
        { "path": "stop_reason", "op": "contains", "value": "{first_funder}" }
      ],
      "tier": "chain-derived",
      "basis": "Nemo's report V1.1 fund tracing names the first 39.45 SUI from 0x1f7b…; the payer of that transaction on chain is the same address."
    },
    {
      "id": "funding-source",
      "question": "Where did the attacker's money first come from?",
      "tool": "find_funding_source",
      "args": { "address": "{attacker}" },
      "expect": [
        { "path": "chain[0].funded_by", "op": "equals", "value": "{first_funder}" },
        { "path": "chain[0].funding_tx", "op": "equals", "value": "{first_funding_tx}" },
        { "path": "stop_reason", "op": "contains", "value": "high-fanout" }
      ],
      "tier": "chain-derived",
      "basis": "Nemo's report V1.1 fund tracing; the funding transaction's payer read on chain."
    },
    {
      "id": "upgrade-cap-at-exploit",
      "question": "Who could upgrade Nemo's package when the exploit ran, and was a version published outside the multisig?",
      "tool": "get_upgrade_history",
      "args": { "package": "{nemo_package}", "as_of": "2025-09-07T16:03:00Z" },
      "expect": [
        { "path": "as_of.holder.address", "op": "equals", "value": "{upgrader}" },
        { "path": "as_of.newest_version.version", "op": "equals", "value": 10 },
        { "path": "flags[*].kind", "op": "includes", "value": "cap_round_trip" },
        { "path": "flags[*].versions[*]", "op": "includes", "value": 10 }
      ],
      "tier": "chain-derived",
      "basis": "The UpgradeCap's owner changes and the package's versions, read on chain."
    }
  ]
}
