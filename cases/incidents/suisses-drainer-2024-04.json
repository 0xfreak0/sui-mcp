  "checks": [
    {
      "id": "victim-tx-recipients",
      "question": "In the drain the victim reported, where did the coins and the LP and farm positions go?",
      "tool": "get_transaction",
      "args": {
        "digest": "{victim_tx}"
      },
      "expect": [
        {
          "path": "sender",
          "op": "iequals",
          "value": "{victim}"
        },
        {
          "path": "object_transfers[*].to.address",
          "op": "includes",
          "value": "{collector_3}"
        },
        {
          "path": "object_transfers[*].object_id",
          "op": "includes",
          "value": "{stolen_lp_token}"
        },
        {
          "path": "object_transfers[*].object_id",
          "op": "count_gte",
          "value": 5
        },
        {
          "path": "balance_changes[*].address",
          "op": "includes",
          "value": "{fee_address}"
        }
      ],
      "tier": "chain-derived",
      "basis": "The GitHub issue names this digest. On chain it transfers five objects (a Kriya LP token, two Kriya farm positions, a Suisses NFT and a Liquidpool object) and 0.631405462 SUI plus 35.113392755 vSUI to the collector, and 0.00369243 SUI to the fee address."
    },
    {
      "id": "decode-ptb-flags-drain",
      "question": "Given the bytes the victim was asked to sign, does pre-sign triage flag that every asset goes to a stranger?",
      "tool": "decode_ptb",
      "args": {
        "transaction_bcs": ""
      },
      "expect": [
        {
          "path": "anomalies[*].evidence[*]",
          "op": "includes",
          "value": "{kit_package_a}::managed::mint"
        },
        {
          "path": "anomalies[*].code",
          "op": "count_gte",
          "value": 2
        }
      ],
      "tier": "chain-derived",
      "basis": "Bytes are the chain's transactionBcs for the victim digest. The PTB has 2 SplitCoins of the gas coin and 8 TransferObjects, all paying addresses other than the sender, and calls two packages on the MystenLabs wallet blocklist."
    },
    {
      "id": "kit-package-blocklisted",
      "question": "Is the package the drainer PTB calls a known scam package?",
      "tool": "analyze_package",
      "args": {
        "package_id": "{kit_package_a}"
      },
      "expect": [
        {
          "path": "flagged_by[*].list",
          "op": "includes",
          "value": "MystenLabs/wallet_blocklist"
        },
        {
          "path": "root_publisher.publisher",
          "op": "iequals",
          "value": "{publisher}"
        }
      ],
      "tier": "indexer-attested",
      "basis": "MystenLabs wallet_blocklist package-list.json lists 0x7ca9d75e…3327. The publisher is the sender of publish tx 4SHgTcDHJZe8RthXBu2NyAva7XeG1t4Wug7eLPBeafiW on chain."
    },
    {
      "id": "lure-nft-same-publisher",
      "question": "Who published the Suisses NFT the victim interacted with, and is its type blocklisted?",
      "tool": "analyze_package",
      "args": {
        "package_id": "{lure_package}"
      },
      "expect": [
        {
          "path": "root_publisher.publisher",
          "op": "iequals",
          "value": "{publisher}"
        },
        {
          "path": "root_publisher.publish_tx",
          "op": "equals",
          "value": "3ySSZmXFaFyj9dJCwCSQpP53vwnWxbWBAVHpAsJ4guSp"
        },
        {
          "path": "flagged_by[*].kind",
          "op": "includes",
          "value": "object-type-package"
        }
      ],
      "tier": "chain-derived",
      "basis": "On chain the liquid::Suisses package was published by 0x021e5069 on 2024-04-04, 20 minutes before the two managed packages, from the same address. MystenLabs wallet_blocklist object-list.json lists the type."
    },
    {
      "id": "first-drain-call",
      "question": "When was the drainer kit first used, and by whom?",
      "tool": "query_transactions",
      "args": {
        "function": "{kit_package_a}::managed::mint",
        "order": "oldest",
        "limit": 5
      },
      "expect": [
        {
          "path": "transactions[0].digest",
          "op": "equals",
          "value": "{first_drain_tx}"
        },
        {
          "path": "transactions[0].sender",
          "op": "iequals",
          "value": "{test_wallet}"
        }
      ],
      "tier": "chain-derived",
      "basis": "Paging every call to managed::mint on chain gives 601 transactions from 2024-04-08 to 2024-05-28; the first is EGTgiLEX, sent by 0xb2fc23a4, which also sent the first drain into each later collector."
    },
    {
      "id": "lure-airdropper",
      "question": "Who airdropped the Suisses lure NFTs?",
      "tool": "query_transactions",
      "args": {
        "function": "{lure_package}::liquid::airdrop",
        "order": "oldest",
        "limit": 50
      },
      "expect": [
        {
          "path": "transactions[0].digest",
          "op": "equals",
          "value": "{first_airdrop_tx}"
        },
        {
          "path": "transactions[*].sender",
          "op": "includes",
          "value": "{airdropper}"
        },
        {
          "path": "transactions[*].sender",
          "op": "count_gte",
          "value": 50
        }
      ],
      "tier": "chain-derived",
      "basis": "On chain all 2,658 liquid::airdrop calls (2024-04-08 to 2024-04-14) were sent by 0x8b58ec72, which also sent the first funding to the package publisher."
    },
    {
      "id": "fee-address-take",
      "question": "How much did the fee address take from victims, and from how many?",
      "tool": "summarize_address_flows",
      "args": {
        "address": "{fee_address}",
        "from": "2024-04-08T00:00:00Z",
        "to": "2024-06-01T00:00:00Z"
      },
      "expect": [
        {
          "path": "coverage.complete",
          "op": "equals",
          "value": true
        },
        {
          "path": "coins[*].raw.in",
          "op": "includes",
          "value": "113810862594"
        },
        {
          "path": "inflow_sources[*].address",
          "op": "count_gte",
          "value": 338
        },
        {
          "path": "recipient_count",
          "op": "equals",
          "value": 0
        }
      ],
      "tier": "chain-derived",
      "basis": "Summing the fee address's SUI balance change over the 599 successful managed::mint transactions on chain gives 113.810862594 SUI in 596 transactions from 338 senders; the address has never sent a transaction."
    },
    {
      "id": "collector3-flows",
      "question": "Who paid collector 3, and where did it send the money?",
      "tool": "summarize_address_flows",
      "args": {
        "address": "{collector_3}",
        "from": "2024-04-23T00:00:00Z",
        "to": "2024-06-30T00:00:00Z"
      },
      "expect": [
        {
          "path": "coverage.complete",
          "op": "equals",
          "value": true
        },
        {
          "path": "inflow_sources[*].address",
          "op": "includes",
          "value": "{victim}"
        },
        {
          "path": "inflow_sources[*].address",
          "op": "count_gte",
          "value": 158
        },
        {
          "path": "top_recipients[*].address",
          "op": "includes",
          "value": "{consolidator}"
        },
        {
          "path": "top_recipients[*].address",
          "op": "includes",
          "value": "{dormant_hub}"
        }
      ],
      "tier": "chain-derived",
      "basis": "On chain 158 victims paid collector 3 in 271 drain transactions, and it sent 31,175.41 SUI and 1,501.67 USDC to 0x025be32e on 2024-05-26 and 1,693.96 SUI and 500.66 USDC to 0xe866957c on 2024-06-01."
    },
